---
import links from 'public/links.json'
import config from 'virtual:config'

import { Button, Collapse, Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'

import FriendList from '@/components/links/FriendList.astro'

const { personal } = links
const linksConf = config.integ.links
const headings = [
  { depth: 2, slug: 'links', text: 'Links' },
  { depth: 2, slug: 'hobbies', text: 'Hobbies' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'social-networks', text: 'Social Networks' },
  { depth: 2, slug: 'about-blog', text: 'About Blog' }
]
---

<PageLayout title='About' {headings} comment>
  <p>Backend Developer, London</p>
  <p>
    I am from a small town up North called Blackburn I moved to London to study Economics at LSE, 
    and I have been here ever since. I have a wide range of interests, but my main 
    passion is backend technology and how it can be used to make life easier. I love collecting and 
    sharing useful resources, and I am always looking for new and interesting projects to work on.
  </p>
  <p>
  </p>

  <h2 id='links'>Links</h2>
  <FriendList list={personal[0]} />

  {/* general-talk */}
  <h2 id='hobbies'>Hobbies</h2>
  <ul>
    <li>I'm an avid runner and a regular at the gym.</li>
    <li>
      I am a lifelong Football fan and support Manchester United (for better or worse!).
    <li>I used to be a resident club DJ back in my home town of Preston, I love making people dance.</li>
    <li>I love my dogs and enjoy nothing more than being in their company. I prefer them to most people (sorry not sorry).</li>
  </ul>

  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <p>Current tools I use are as follow:</p>
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'WezTerm',
        description: 'Terminal Emulator',
        href: 'https://wezfurlong.org/wezterm/',
        icon: import('@/assets/tools/wezterm.svg?raw')
      },
            {
        name: 'VS Code',
        description: 'IDE',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'Neovim',
        description: 'IDE',
        href: 'https://neovim.io/',
        icon: import('@/assets/tools/neovim.svg?raw')
      },
      {
        name: 'Fish Shell',
        description: 'Shell',
        href: 'https://fishshell.com/',
        icon: import('@/assets/tools/fishshell.svg?raw')
      },
            {
        name: 'GitHub',
        description: 'Code Hosting',
        href: 'https://github.com/',
        icon: import('@/assets/tools/github.svg?raw')
      },
      {
        name: 'GitLab',
        description: 'Code Hosting',
        href: 'https://gitlab.com/',
        icon: import('@/assets/tools/gitlab.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Productivity'
    tools={[
      {
        name: 'Zen',
        description: 'Browser',
        href: 'https://zen-browser.app/',
        icon: import('@/assets/tools/zen.svg?raw')
      },
      {
        name: 'Notion',
        description: 'Note Taking',
        href: 'https://www.notion.so/',
        icon: import('@/assets/tools/notion.svg?raw')
      },
      {
        name: 'Todoist',
        description: 'Task Management',
        href: 'https://todoist.com/',
        icon: import('@/assets/tools/todoist.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Languages, Frameworks & Tools'
    tools={[
      {
        name: 'Python',
        description: 'Programming Language',
        href: 'https://www.python.org/',
        icon: import('@/assets/tools/python.svg?raw')
      },
      {
        name: 'Bash',
        description: 'Scripting Language',
        href: 'https://www.gnu.org/software/bash/',
        icon: import('@/assets/tools/bash.svg?raw')
      },
      {
        name: 'uv',
        description: "Python package manager",
        href: 'https://uv.pypa.io/en/latest/',
        icon: import('@/assets/tools/uv.svg?raw')
      },
      {
        name: 'FastAPI',
        description: 'Web Framework',
        href: 'https://fastapi.tiangolo.com/',
        icon: import('@/assets/tools/fastapi.svg?raw')
      },
      {
        name: 'Flask',
        description: 'Web Framework',
        href: 'https://flask.palletsprojects.com/',
        icon: import('@/assets/tools/flask.svg?raw')
      },
      {
        name: 'Pydantic',
        description: 'Data Validation',
        href: 'https://pydantic-docs.helpmanual.io/',
        icon: import('@/assets/tools/pydantic.svg?raw')
      },
      {
        name: 'Docker',
        description: 'Containerization',
        href: 'https://www.docker.com/',
        icon: import('@/assets/tools/docker.svg?raw')
      },
      {
        name: 'PostgreSQL',
        description: 'Database',
        href: 'https://www.postgresql.org/',
        icon: import('@/assets/tools/postgresql.svg?raw')
      },
      {
        name: 'Redis',
        description: 'Database',
