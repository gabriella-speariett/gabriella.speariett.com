        icon: import('@/assets/tools/github-actions.svg?raw')
      },
      {
        name: 'Celery',
        description: 'Task Queue',
        href: 'https://docs.celeryq.dev/en/stable/',
        icon: import('@/assets/tools/celery.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='AI'
    tools={[
      {
        name: 'Claude',
        description: 'AI Assistant',
        href: 'https://www.anthropic.com/claude',
        icon: import('@/assets/tools/claude.svg?raw')
      },
      {
        name: 'Gemini',
        description: 'AI Assistant',
        href: 'https://www.google.com/intl/en_ai/',
        icon: import('@/assets/tools/gemini.svg?raw')
      },
      {
        name: 'OpenAI',
        description: 'AI Assistant',
        href: 'https://chat.openai.com/',
        icon: import('@/assets/tools/openai.svg?raw')
      }
    ]}
  />

  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'Raspberry Pi',
        description: 'Mini Computer',
        href: 'https://www.raspberrypi.org/',
        icon: import('@/assets/tools/raspberry-pi.svg?raw')
      },
      {
        name: 'Ubuntu 24.04 LTS',
        description: 'Linux Distribution',
        href: 'https://ubuntu.com/',
        icon: import('@/assets/tools/ubuntu.svg?raw')
      },
      {
        name: 'MacOS Sequioa',
        description: 'MacBook Air M3',
        href: 'https://www.apple.com/macos/',
        icon: import('@/assets/tools/apple.svg?raw')
      },
      {
        name: 'Windows 11',
        description: 'Secondary Computer',
        href: 'https://news.microsoft.com/windows11-general-availability/',
        icon: import('@/assets/tools/windows11.svg?raw')
      }
    ]}
  />

  {/* social-networks */}
  <h2 id='social-networks'>Networks</h2>
  <p>
    You can find me on the following platforms:
  </p>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/gabriella-speariett',
        text: 'followers',
        api: 'github/gabriella-speariett'
      }
    ]}
  />

  {/* about-blog */}
  <h2 id='about-blog'>About Blog</h2>
  <p>Website history:</p>
  <Timeline
    events={[
      {
        date: '2026-01-01',
        content:
          'Made a decision to build a personal website to share my thoughts and projects, and to document my learning journey.'
      },
      {
        date: '2026-05-04',
        content:
          'Website went live!'
      }
    ]}
  />
  <p>
    The smooth operation and personalised customisation of website also rely on the resources and
    technical support provided by the following excellent projects/service providers:
  </p>
  <ul>
    <li>Domain: <a href='#' target='_blank'>Cloudflare</a></li>
    <li>
      Framework & Theme: <a href='https://astro.build/' target='_blank'>Astro</a> + <a
        href='https://github.com/cworld1/astro-theme-pure'
        target='_blank'>Astro Theme Pure</a
      >
    </li>
    <li>
      Site hosting: <a href='https://cloudflare.com/' target='_blank'>Cloudflare</a>
    </li>
    <li>
      CI/CD: <a href='https://github.com/' target='_blank'>GitHub Actions</a>
    </li>
    <li>Comment system: <a href='https://waline.js.org' target='_blank'>Waline</a></li>
    <li>
      Visits: <a href='https://supabase.com/' target='_blank'>Supabase</a> +
      <a href='https://waline.js.org/' target='_blank'>Waline</a>
    </li>
    <li>
      Other statistics: <a href='https://github.com/spencerwooo/substats' target='_blank'
        >Substats</a
      >
    </li>
  </ul>
</PageLayout>
