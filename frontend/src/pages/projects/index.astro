---
import { Image } from 'astro:assets'

import { Collapse } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'current-projects', text: 'Current Projects' },
  { depth: 2, slug: 'older-projects', text: 'Older Projects' },
]
---
<PageLayout title='Projects' {headings} view>
  <p>Please find below a list of my current and older projects, my older projects are not actively maintained or updated and were written before I had any professional experience.</p>
  <h2 id='current-projects'>Current Projects</h2>
  <ProjectSection
    projects={[
      {
        name: '🔧 Centralised Configuration',
        description: 'A place to store all my setup scripts and dotfiles',
        links: [
          { type: 'github', href: 'https://github.com/gabriella-speariett/dotty' },
          { type: 'doc', href: '../blog/custom-configuration' },
        ]
      },
      {
        name: '🔖 Self-hosted Bookmarker',
        description: 'Self hosting Wallabag to save and manage all my bookmarks',
        links: [
          { type: 'github', href: 'https://t3.ftcdn.net/jpg/05/20/48/46/360_F_520484683_j4f2om7llvZD1aoL9HPZ2LmDeWWZoWK0.jpg' },
          // { type: 'site', href: 'https://github.com/zhuozhiyongde/pku-art' },
          // { type: 'doc', href: '../blog/self-hosting-a-bookmarker' }
        ]
      },
      {
        name: '📚 Custom Library',
        description: 'A script to beautify pku course website',
        links: [
          { type: 'github', href: 'https://t3.ftcdn.net/jpg/05/20/48/46/360_F_520484683_j4f2om7llvZD1aoL9HPZ2LmDeWWZoWK0.jpg' },
          // { type: 'site', href: 'https://github.com/zhuozhiyongde/pku-art' },
          // { type: 'doc', href: '../blog/self-hosting-a-bookmarker' }
        ]
      }
    ]}
  />
  <Collapse title='GitHub Activity'>
  <p>Note, I use a private GitLab professionally, so my GitHub activity does not reflect all my work.</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/gabriella-speariett'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  </Collapse>

  <h2 id='older-projects'>Older Projects</h2>
    <p> Here are some of my older projects that I made with no work experience, but they might not be actively maintained or updated:</p>
  <ProjectSection
    class='my-2'
    projects={[
      {
        name: '📊 Interactive Dashboard Personal',
        description: 'An interactive dashboard that auto collects data from multiple areas from my daily life including health & productivity.',
        links: [
          { type: 'github', href: 'https://github.com/gabriella-speariett/Interactive-Dashboard' },
          { type: 'doc', href: 'https://github.com/gabriella-speariett/Interactive-Dashboard/blob/main/README.md' }
        ]
      },       
      {
        name: '🔍 Google Jobs Scraper',
        description: 'A web scraper built with Python, Selenium, and BeautifulSoup to extract job listsings from Google Jobs, featuring data cleaning and CSV export functionality.',
        links: [
          { type: 'github', href: 'https://github.com/gabriella-speariett/Web-Scraping/tree/main' },
          { type: 'doc', href: 'https://github.com/gabriella-speariett/Web-Scraping/blob/main/readme.md' }
        ]
      },
      {
        name: '🎵 DJ Flask App',
        description: 'A Flask web application that allows DJs to take a seed track and find similar songs.',
        links: [
          { type: 'github', href: 'https://github.com/gabriella-speariett/DJ-Flask-App' },
          { type: 'doc', href: 'https://github.com/gabriella-speariett/DJ-Flask-App/blob/main/README.md'  }
        ]
      },
      {
        name: '📰 Political News',
        description: 'A web application that aggregates and analyses political news articles.',
        links: [
          { type: 'github', href: 'https://github.com/gabriella-speariett/Political-News'},
          { type: 'doc', href: 'https://github.com/gabriella-speariett/Political-News/blob/main/README.md'}
        ]
      },
      {
        name: '⚽ Premier League Dashboard',
        description: 'A web application that aggregates and analyses Premier League data.',
        links: [
          { type: 'github', href: 'https://github.com/gabriella-speariett/Manchester-United' },
          { type: 'doc', href: 'https://github.com/gabriella-speariett/Manchester-United/blob/main/README.md' }
        ]
      },
      
    ]}
  />


</PageLayout>
